{
  "name": "lifeline",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host",
    "build": "tsc --noEmit && vite build",
    "build:single": "vite build --mode single",
    "preview": "vite preview --host",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "tsc --noEmit && vitest run",
    "balance": "node --experimental-strip-types tools/balance.ts",
    "shots": "node tools/shots.mjs"
  },
  "dependencies": {
    "@fontsource/pixelify-sans": "5.3.0",
    "@preact/signals": "2.11.3",
    "preact": "10.29.8",
    "zzfx": "1.4.0"
  },
  "devDependencies": {
    "playwright": "1.63.0",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "vite-plugin-pwa": "2.0.0",
    "vite-plugin-singlefile": "2.3.4",
    "vitest": "5.0.5"
  }
}
